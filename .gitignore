# Secrets and local config — never commit
config/*
!config/.env.example
!config/risk.example.json

# Historical price data
data/*
!data/.gitkeep

# SQLite journal/WAL files
memory/*.db-journal
memory/*.db-wal
memory/*.db-shm

# Python
__pycache__/
*.pyc
.venv/

# Local account state
memory/peak_equity.json
memory/*.backup-*.db

# Local run state and logs
memory/run_daily.lock
logs/
memory/alert_state.json
.venv-tsfm/
.claude/settings.local.json
