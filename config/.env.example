# Copy to config/.env and fill in your Alpaca PAPER keys.
# Paper keys come from the Paper Trading section of the Alpaca dashboard.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true

# Optional phone alerts via https://ntfy.sh. Pick a long random topic name: anyone who knows it
# can read your alerts. Leave blank for Mac notifications only.
NTFY_TOPIC=
