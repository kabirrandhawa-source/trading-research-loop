<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.kabirrandhawa.trading-loop.pm-archive</string>

    <!-- Nightly: xz-compress finished days of recorded market data (about 6x smaller), verified before deleting. -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/kabir/trading-research-loop/.venv/bin/python</string>
        <string>-W</string>
        <string>ignore</string>
        <string>-m</string>
        <string>pm.archive</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/kabir/trading-research-loop</string>
    <key>StartCalendarInterval</key>
    <dict><key>Hour</key><integer>1</integer><key>Minute</key><integer>15</integer></dict>
    <key>StandardOutPath</key>
    <string>/Users/kabir/trading-research-loop/logs/pm_archive.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/kabir/trading-research-loop/logs/pm_archive.log</string>
    <key>ProcessType</key>
    <string>Background</string>
    <key>LowPriorityIO</key>
    <true/>
</dict>
</plist>
